# Execution Mode: "saas" or "standalone"
MODE=saas

# Server Port
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telegram_commerce?schema=public"

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379"

# Cryptographic Keys (Must be 32-byte hex for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super-secret-jwt-key-replace-in-production-12345"

# Master SaaS Bot (Required in SaaS mode for onboarding)
MASTER_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Base URLs
PUBLIC_API_URL="http://localhost:3000"
PUBLIC_MINIAPP_URL="http://localhost:5173"
PUBLIC_ADMIN_URL="http://localhost:5174"
PUBLIC_LANDING_URL="http://localhost:5175"

# Stripe Configuration (Required in SaaS mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_BASIC_PLAN_PRICE_ID="price_basic20"
STRIPE_PRO_PLAN_PRICE_ID="price_pro30"
STRIPE_STANDALONE_PRICE_ID="price_standalone350"

# Standalone Deployment Overrides (Used when MODE=standalone)
STANDALONE_TENANT_ID="00000000-0000-0000-0000-000000000001"
STANDALONE_BOT_TOKEN=""
STANDALONE_ADMIN_TELEGRAM_ID=""
