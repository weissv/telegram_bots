FROM node:22-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@11.24.0

FROM base AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/master-bot/ ./apps/master-bot/

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @telegram-commerce/database db:generate
RUN pnpm --filter @telegram-commerce/master-bot build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN npm install -g pnpm@11.24.0

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/packages/ ./packages/
COPY --from=builder /app/apps/master-bot/ ./apps/master-bot/
COPY --from=builder /app/node_modules/ ./node_modules/

CMD ["node", "apps/master-bot/dist/index.js"]
