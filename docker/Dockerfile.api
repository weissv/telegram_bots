# esbuild's npm binaries embed the Go stdlib they were compiled with.
# 0.21.5 is go1.20.12 (CVE-2023-45288, CVE-2024-24790, CVE-2025-68121);
# 0.25.12 is go1.23.12 and 0.28.2 is go1.26.5. The runtime image copies
# node_modules, so rebuild those same releases with Go 1.26.11.
FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS esbuild-stdlib
RUN apk add --no-cache git ca-certificates
WORKDIR /src
ENV CGO_ENABLED=0 \
    GOFLAGS=-trimpath \
    GOTOOLCHAIN=local
RUN set -eu; \
    mkdir -p /out; \
    for v in 0.21.5 0.25.12 0.28.2; do \
      git clone --depth 1 --branch "v${v}" https://github.com/evanw/esbuild.git "esbuild-${v}"; \
      (cd "esbuild-${v}" && go build -o "/out/esbuild-${v}" ./cmd/esbuild); \
      ver_out=$(go version -m "/out/esbuild-${v}"); \
      printf '%s\n' "$ver_out" | grep -q 'go1\.26\.11'; \
      built=$("/out/esbuild-${v}" --version); \
      [ "$built" = "$v" ]; \
    done

FROM node:22-alpine AS base
WORKDIR /app
RUN apk upgrade --no-cache \
    && apk add --no-cache curl openssl \
    && npm install -g pnpm@11.24.0 --fetch-retries=5 --fetch-retry-mintimeout=20000

FROM base AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY scripts/ ./scripts/

RUN pnpm install --frozen-lockfile=false
COPY docker/patch-esbuild-stdlib.sh /tmp/patch-esbuild-stdlib.sh
COPY --from=esbuild-stdlib /out/ /opt/esbuild-stdlib/
RUN sh /tmp/patch-esbuild-stdlib.sh /app/node_modules /opt/esbuild-stdlib \
    && rm -rf /opt/esbuild-stdlib /tmp/patch-esbuild-stdlib.sh
RUN pnpm --filter @telegram-commerce/database db:generate
RUN pnpm --filter @telegram-commerce/config build
RUN pnpm --filter @telegram-commerce/i18n build
RUN pnpm --filter @telegram-commerce/ui build
RUN pnpm --filter @telegram-commerce/database build
RUN pnpm --filter @telegram-commerce/payments build
RUN pnpm --filter @telegram-commerce/telegram-engine build
RUN pnpm --filter @telegram-commerce/master-bot build
RUN pnpm --filter @telegram-commerce/miniapp build
RUN pnpm --filter @telegram-commerce/admin build
RUN pnpm --filter @telegram-commerce/landing build
RUN pnpm --filter @telegram-commerce/api build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/packages/ ./packages/
COPY --from=builder /app/apps/ ./apps/
COPY --from=builder /app/scripts/ ./scripts/
COPY --from=builder /app/node_modules/ ./node_modules/

EXPOSE 3000
CMD ["sh", "-c", "echo '🔄 Applying Prisma DB schema...' && (pnpm --filter @telegram-commerce/database exec prisma db push --skip-generate || echo '⚠️ prisma db push deferred to runtime ensureSchemaMigrated') && echo '🚀 Starting Unified Platform Engine...' && node apps/api/dist/index.js"]
