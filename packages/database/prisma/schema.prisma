datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Plan {
  BASIC_20
  PRO_30
  STANDALONE_LIFETIME
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum OrderStatus {
  PENDING
  PAYMENT_REVIEW
  PAID
  DELIVERED
  CANCELLED
  REFUNDED
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

model Tenant {
  id                  String             @id @default(uuid())
  name                String
  owner_telegram_id   String
  plan                Plan               @default(BASIC_20)
  subscription_status SubscriptionStatus @default(PENDING_PAYMENT)
  is_active           Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  botConfig           BotConfig?
  subscriptions       Subscription[]
  products            Product[]
  orders              Order[]
  adminUsers          AdminUser[]

  @@index([owner_telegram_id])
  @@index([plan])
  @@index([subscription_status])
}

model BotConfig {
  tenant_id            String   @id
  bot_token_encrypted  String
  bot_username         String?
  webhook_secret       String
  is_active            Boolean  @default(false)
  currency             String   @default("UZS")
  theme_config         Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant               Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([bot_username])
}

model Subscription {
  id                     String             @id @default(uuid())
  tenant_id              String
  plan                   Plan               @default(BASIC_20)
  invoice_number         String?            @unique
  amount_uzs             Int?
  payment_reference      String?
  reviewed_by            String?
  reviewed_at            DateTime?
  stripe_customer_id     String?
  stripe_subscription_id String?            @unique
  status                 SubscriptionStatus @default(PENDING_PAYMENT)
  current_period_end     DateTime?
  cancel_at_period_end   Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant                 Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([status])
}

model Product {
  id          String   @id @default(uuid())
  tenant_id   String
  title       String
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String[] @default([])
  variants    Json     @default("[]")
  category    String   @default("General")
  is_active   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([id, tenant_id])
  @@index([tenant_id])
  @@index([tenant_id, category])
  @@index([tenant_id, is_active])
}

model Order {
  id                   String      @id @default(uuid())
  tenant_id            String
  customer_telegram_id String
  customer_name        String?
  total_amount         Decimal     @db.Decimal(10, 2)
  delivery_fee         Decimal     @default(0) @db.Decimal(10, 2)
  delivery_method      String      @default("COURIER")
  status               OrderStatus @default(PENDING)
  payment_method       String      @default("PAYNET_XOLIS")
  payment_id           String?
  access_token         String?
  receipt_url          String?
  verified_at          DateTime?
  verified_by          String?
  status_history       Json        @default("[]")
  items                Json        @default("[]")
  shipping_address     String?
  customer_phone       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant               Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([id, tenant_id])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([customer_telegram_id])
}

model AdminUser {
  id            String    @id @default(uuid())
  tenant_id     String
  email         String
  password_hash String
  role          AdminRole @default(OWNER)
  language      String    @default("ru")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@index([tenant_id])
}
